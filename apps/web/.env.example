# Vivly web app environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# IMPORTANT: every VITE_ variable is compiled into the public browser bundle.
# Never put a secret key here. Payment gateway credentials belong in the
# Cloudflare Worker (see below).

# Worker API base URL, including the /api suffix
VITE_API_URL=http://localhost:8787/api

# Supabase project (anon key is public by design and protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─────────────────────────────────────────────────────────────────────────────
# Worker secrets — set these with `wrangler secret put <NAME>`, NOT here
# ─────────────────────────────────────────────────────────────────────────────
# CASHFREE_APP_ID          Cashfree client id
# CASHFREE_SECRET_KEY      Cashfree secret key — server only
# CASHFREE_WEBHOOK_SECRET  Webhook signing secret (defaults to the secret key)
# CASHFREE_ENV             'sandbox' (default) or 'production'
# ADMIN_EMAILS             Comma-separated admin allowlist
# FRONTEND_URL             Public site origin, used for CORS and return URLs
