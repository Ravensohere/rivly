  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @vivly/web",
    "dev:worker": "npm run dev -w worker",
    "build": "npm run build -w @vivly/web",
    "lint": "npm run lint -w @vivly/web",
    "preview": "npm run preview -w @vivly/web",
    "typecheck": "npm run typecheck -w @vivly/web && npm run typecheck -w rivly-worker",
    "test": "npm run test -w @vivly/web && npm run test -w rivly-worker",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
